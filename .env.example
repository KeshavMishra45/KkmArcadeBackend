# Copy to ".env" for local use. On Vercel add the same names under Project Settings -> Environment Variables. Never commit .env.
PORT=5000

# Atlas connection string, with the database name "kkm_games" right after .mongodb.net/
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/kkm_games?retryWrites=true&w=majority

# Any long random string:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Points every new account starts with (1000 to test the shop, 0 for real use)
STARTING_POINTS=1000

# Your deployed FRONTEND address(es), comma separated, no trailing slash. Local example: http://127.0.0.1:5500,http://localhost:5500
CLIENT_ORIGIN=https://your-frontend.vercel.app
